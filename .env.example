# Autonomous Trading Bot environment template
# This is for educational/backtesting/paper-trading use only. Live trading involves substantial risk of loss. Not financial advice.

# ---- Core runtime ----
DEBUG=True
MARKET_DATA_SOURCE=live
# Seconds to wait for a market data request before failing it
MARKET_DATA_TIMEOUT_SECONDS=10
# Bid/ask spread in basis points used by the simulated source
SIM_SPREAD_BPS=2
# Extra paper-fill slippage in basis points on top of pricing at the bid and ask
PAPER_EXTRA_SLIPPAGE_BPS=0
# Spread in basis points paper fills assume when a quote has no bid and ask
PAPER_FALLBACK_SPREAD_BPS=2
TRADING_MODE=paper
JWT_SECRET=replace-with-at-least-32-random-characters
# Access token lifetime in hours (1-168). POST /api/auth/logout-all revokes a user's existing tokens.
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://mongo:27017
DB_NAME=trading_bot

# Runtime roles: api, worker, all, indexes
# Local Docker Compose overrides this per service.
RUNTIME_ROLE=all
API_EMBED_BOT_MANAGER=True
RUN_MONGO_INDEX_BOOTSTRAP=True

# ---- Ops admin ----
OPS_ADMIN_ENABLED=False
OPS_ADMIN_EMAILS=

# ---- Coinbase readonly/live credentials ----
# Store real secrets in a secret manager. Do not commit real values.
COINBASE_EXCHANGE_URL=https://api.exchange.coinbase.com
COINBASE_EXCHANGE_API_KEY=
COINBASE_EXCHANGE_API_SECRET=
COINBASE_EXCHANGE_PASSPHRASE=

# ---- Manual gated live-trading controls ----
LIVE_TRADING_ENABLED=False
LIVE_EXECUTION_ADAPTER=disabled
LIVE_ALLOWED_SYMBOLS=BTC-USD,ETH-USD
LIVE_MAX_ORDER_NOTIONAL_USD=25
LIVE_MANUAL_APPROVAL_REQUIRED=True
LIVE_SIGNED_APPROVAL_REQUIRED=True
LIVE_APPROVAL_TOKEN=
COINBASE_LIVE_ORDER_KILL_SWITCH=True

# ---- Frontend ----
REACT_APP_BACKEND_URL=http://localhost:8000
